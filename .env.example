# Google OAuth 2.0 Client ID for an application of type "Desktop app".
# Copy this file to .env and replace both placeholders locally for debug builds.
# Do not add a VITE_ prefix: OAuth configuration must stay out of React bundles.
ZEROCHI_GOOGLE_CLIENT_ID=replace-with-your-desktop-client-id.apps.googleusercontent.com
ZEROCHI_GOOGLE_CLIENT_SECRET=replace-with-your-desktop-client-secret
# Optional, for Outlook: the "Application (client) ID" of a Microsoft Entra app registration
# configured as a public client with the redirect URI http://localhost. It has no secret.
ZEROCHI_MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
