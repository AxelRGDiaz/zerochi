{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zerochi",
  "version": "../package.json",
  "identifier": "com.zerochi.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Zerochi",
        "width": 390,
        "height": 600,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "macOS": {
      "entitlements": "Entitlements.plist",
      "hardenedRuntime": true,
      "signingIdentity": "Developer ID Application: Aplicaciones Tecnológicas Limitada (XVSL3QSK7G)",
      "files": {
        "embedded.provisionprofile": "signing/Zerochi_Developer_ID_Distribution.provisionprofile"
      },
      "dmg": {
        "background": "dmg/background.png",
        "windowSize": {
          "width": 600,
          "height": 400
        }
      }
    },
    "resources": {
      "resources/notification-chime.wav": "notification-chime.wav"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
