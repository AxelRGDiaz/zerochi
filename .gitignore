*.mobileprovision
*.cer
*.crt
*.der
*.csr
*.p8
*.p12
*.pfx
*.pem
*.key
*.keychain
*.keychain-db

# Other signing containers that must use a local/CI secret store
*.jks
*.keystore

*.tsbuildinfo
